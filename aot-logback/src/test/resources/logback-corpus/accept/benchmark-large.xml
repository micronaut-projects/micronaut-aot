<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>
    <logger name="io.micronaut.runtime.Micronaut" level="INFO"/>
    <root level="WARN">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
