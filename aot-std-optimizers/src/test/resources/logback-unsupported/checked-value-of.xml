<configuration>
    <appender name="STDOUT" class="io.micronaut.aot.std.sourcegen.LogbackConfigurationSourceGeneratorTest$CheckedExceptionAppender">
        <tag>out</tag>
        <encoder><pattern>%msg%n</pattern></encoder>
